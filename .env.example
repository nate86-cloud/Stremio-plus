# Client-side public env — ONLY anon/public keys here. Never put service_role or secrets here (Vite exposes VITE_* to the browser bundle).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry — public DSN (safe to expose to browser). If empty, Sentry is disabled and app runs normally.
# Get this from Sentry → Settings → Projects → Client Keys (DSN).
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/123
# For Electron main process (same DSN, but read via process.env). You can also set SENTRY_DSN in your shell / CI.
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/123
# Optional: SENTRY_ENVIRONMENT=production

# Supabase service_role key (SUPABASE_SERVICE_ROLE_KEY) must ONLY be set as a Supabase Edge Function secret:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=... --project-ref <ref>
# or via Supabase Dashboard → Edge Functions → Secrets. Never add it to this file or .env.

# ── Auto-updater (electron-updater) ──────────────────────────────────────
# No env needed for runtime — updates are fetched from your GitHub Releases (or other provider) configured in electron-builder.
# For publishing you need GH_TOKEN in CI (never commit it):
#   GH_TOKEN=ghp_xxx  (GitHub personal access token with repo scope)
# See package.json `build.publish` and https://www.electron.build/configuration/publish
